# // Core helper to execute lutgen apply with correct CLI argument ordering:
# // lutgen apply [LUTGEN_ARGS] [PALETTE_OPT] <INPUT> -o <OUTPUT> [-- <CUSTOM_COLORS>]
run_lutgen_apply() {
    local src="$1"
    local dest="$2"
    local theme="$3"
    shift 3
    local -a custom_colors=("$@")

    local -a p_opt=()
    local -a c_args=()
    local -a sorted_palette=($(get_palette_colors_sorted "$theme"))

    if [[ ${#custom_colors[@]} -gt 0 ]]; then
        c_args=(-- "${custom_colors[@]}")
    else
        # // No specific colors chosen: check PALETTE_LIMIT
        case "${PALETTE_LIMIT:-All}" in
            2)
                if [[ ${#sorted_palette[@]} -ge 2 ]]; then
                    c_args=(-- "${sorted_palette[0]}" "${sorted_palette[-1]}")
                else
                    p_opt=(-p "${theme,,}")
                fi
                ;;
            4)
                if [[ ${#sorted_palette[@]} -ge 4 ]]; then
                    local n=${#sorted_palette[@]}
                    c_args=(-- "${sorted_palette[0]}" "${sorted_palette[$(( n / 3 ))]}" "${sorted_palette[$(( (2 * n) / 3 ))]}" "${sorted_palette[$(( n - 1 ))]}")
                else
                    c_args=(-- "${sorted_palette[@]}")
                fi
                ;;
            8)
                if [[ ${#sorted_palette[@]} -ge 8 ]]; then
                    local n=${#sorted_palette[@]}
                    local -a subset=()
                    for ((k=0; k<8; k++)); do
                        subset+=("${sorted_palette[$(( (k * (n - 1)) / 7 ))]}")
                    done
                    c_args=(-- "${subset[@]}")
                else
                    c_args=(-- "${sorted_palette[@]}")
                fi
                ;;
            *)
                local candidate="${theme,,}"
                if lutgen palette "$candidate" &>/dev/null; then
                    p_opt=(-p "$candidate")
                elif lutgen palette "${candidate}-dark" &>/dev/null; then
                    p_opt=(-p "${candidate}-dark")
                else
                    if [[ ${#sorted_palette[@]} -gt 0 ]]; then
                        c_args=(-- "${sorted_palette[@]}")
                    else
                        p_opt=(-p "$candidate")
                    fi
                fi
                ;;
        esac
    fi

    lutgen apply "${LUTGEN_ARGS[@]}" "${p_opt[@]}" "$src" -o "$dest" "${c_args[@]}"
}

# // Core processing logic
# // Returns: 0=Processed, 1=Skipped (cache hit), 2=Lutgen error

process_image() {
    local src="$1" dest="$2" theme="$3"
    
    # // If destination is newer than source, skip processing to save time
    if [[ -f "$dest" && ! "$src" -nt "$dest" ]]; then
        return 1
    fi
    
    mkdir -p "$(dirname "$dest")"
    cp "$src" "$dest"

    local tmp="${dest}_lutgen_tmp.${dest##*.}"
    local err_file
    err_file=$(mktemp)

    if run_lutgen_apply "$dest" "$tmp" "$theme" "${SELECTED_COLORS[@]}" &>"$err_file"; then
        mv "$tmp" "$dest"
        rm -f "$err_file"

        # // Apply Color Strength blending with original if < 100%
        if [[ "$COLOR_STRENGTH" -lt 100 ]]; then
            "$IM_CMD" "$src" "$dest" -define compose:args="$COLOR_STRENGTH" -compose blend -composite "$dest" 2>/dev/null
        fi

        # // Apply post-processing enhancements (saturation, contrast, brightness)
        if [[ "$SATURATION" != "100" || "$CONTRAST" != "0" || "$BRIGHTNESS" != "100" ]]; then
            "$IM_CMD" "$dest" -modulate "${BRIGHTNESS},${SATURATION},100" -brightness-contrast "0x${CONTRAST}" "$dest" 2>/dev/null
        fi

        return 0
    else
        rm -f "$tmp"
        echo -e "${C_RED}[ERROR] lutgen failed for '$src':${C_RESET}" >&2
        cat "$err_file" | sed 's/^/  /' >&2
        rm -f "$err_file"
        return 2
    fi
}

