#!/usr/bin/env bash

# /*
#  * LUTGEN RICER
#  * Author: Ezequiel (Zeke)
#  *
#  * Interactive script for wallpaper ricing.
#  * Flow managed via state machine to allow backtracking (ESC).
#  */

# //
# // Color variables for logging
# //

C_BLUE="\e[1;34m"; C_GREEN="\e[1;32m"; C_RED="\e[1;31m"; C_YELLOW="\e[1;33m"; C_CYAN="\e[1;36m"; C_RESET="\e[0m"

# //
# // Base Configuration
# //

REPO_URL="https://github.com/ezequielgk/noctalia-colorschemes"
LUTGEN_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lutgen"
SYNC_MARKER="$LUTGEN_DIR/.synced"

# // Persistent processing settings (KEY=VALUE)
CONFIG_FILE="$LUTGEN_DIR/ricer.conf"
CONFIG_NAME="ricer.conf"

# // Processing settings defaults (mirror lutgen defaults / legacy behavior)
ALGORITHM="gaussian-blur"
PRESERVE="false"
LUM="1.0"
SHAPE="128.0"
NEAREST="16"
LEVEL="10"
RADIUS="8.0"

# // Image enhancement adjustments (ImageMagick post-processing)
SATURATION="100"       # // Percentage: 100 = default, >100 = saturated, <100 = desaturated
CONTRAST="0"           # // -50 to 50
BRIGHTNESS="100"       # // Percentage: 100 = default
COLOR_STRENGTH="100"   # // 10 to 100: blend percentage with original
PALETTE_LIMIT="All"    # // All | 8 | 4 | 2

# // Palette state
CURRENT_PALETTE="gruvbox-dark"
SELECTED_COLORS=()

# // Supported image extensions (webp included)
IMG_PATTERN=(-iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp")

# // ImageMagick command (prefer modern 'magick', fall back to legacy 'convert')
if command -v magick &>/dev/null; then
    IM_CMD="magick"
elif command -v convert &>/dev/null; then
    IM_CMD="convert"
else
    IM_CMD="magick"
fi

# // Global fzf styling for UI consistency
export FZF_DEFAULT_OPTS="--layout=reverse --border=rounded --info=inline --prompt='❯ '"

# // Ensure config directory exists before anything else
mkdir -p "$LUTGEN_DIR"

# /*
#  * PREVIEW GENERATORS (TEMP SCRIPTS)
#  * Using temporary files for fzf previews.
#  * Trap handles cleanup when the script exits or is interrupted.
#  */

PREVIEW_SCRIPT=$(mktemp)
LUTGEN_PREVIEW_SCRIPT=$(mktemp)
LIVE_PREVIEW_SCRIPT=$(mktemp)
SAMPLE_IMAGE=""
trap 'rm -f "$PREVIEW_SCRIPT" "$LUTGEN_PREVIEW_SCRIPT" "$LIVE_PREVIEW_SCRIPT"' EXIT SIGINT SIGTERM

# //
# // 1. Preview for local palettes (Generates ANSI TrueColor blocks)
# //

cat << 'EOF' > "$PREVIEW_SCRIPT"
#!/usr/bin/env bash
lutgen_dir="$1"
shift # // Drop the first argument to iterate cleanly over the rest

for item in "$@"; do
    files=()
    # // Quick check: is it a direct file (Settings) or a base name (Selector)?
    if [[ -f "$lutgen_dir/$item" ]]; then
        files=("$item")
    else
        files=("$item-dark" "$item-light")
    fi

    for file in "${files[@]}"; do
        # // Skip silently if the variant doesn't exist
        [[ ! -f "$lutgen_dir/$file" ]] && continue
        
        # // Read hex values and build ANSI blocks
        read -r -a colors < "$lutgen_dir/$file"
        [[ ${#colors[@]} -eq 0 ]] && continue

        echo -e "    Palette: $file\n"

        for _ in 1 2 3; do
            echo -n "  "
            for hex in "${colors[@]}"; do
                hex="${hex//\#/}" # // Sanitize '#' just in case
                if [[ ${#hex} -eq 6 ]]; then
                    # // Bash black magic to convert HEX to native RGB
                    r=$((16#${hex:0:2}))
                    g=$((16#${hex:2:2}))
                    b=$((16#${hex:4:2}))
                    printf "\e[48;2;%d;%d;%dm        \e[0m" "$r" "$g" "$b"
                fi
            done
            echo ""
        done
        echo -e "\n"
    done
done
EOF
chmod +x "$PREVIEW_SCRIPT"

# //
# // 2. Preview for Lutgen built-in palettes (Fast/Lightweight version)
# //

cat << 'EOF' > "$LUTGEN_PREVIEW_SCRIPT"
#!/usr/bin/env bash
palette="$1"

echo -e "\n  󰏘  Built-in Palette: $palette\n"
echo -e "  [i] Color preview not available."
echo -e "      Built-in palettes are compiled"
echo -e "      inside the lutgen binary."
echo -e "\n  Use lutgen-studio for previews."
EOF
chmod +x "$LUTGEN_PREVIEW_SCRIPT"

# //
# // 3. Preview for live processing adjustments (Image preview with Chafa)
# //

cat << 'EOF' > "$LIVE_PREVIEW_SCRIPT"
#!/usr/bin/env bash

main_preview() {
    sample_img="$PREV_IMG"
    lutgen_dir="$PREV_LUTGEN_DIR"
    im_cmd="${PREV_IM_CMD:-magick}"
    current_palette="$PREV_PALETTE"
    custom_colors="$PREV_COLORS"
    color_strength="${PREV_STRENGTH:-100}"
    palette_limit="${PREV_LIMIT:-All}"
    sat="${PREV_SAT:-100}"
    contrast="${PREV_CONTRAST:-0}"
    bright="${PREV_BRIGHT:-100}"
    item_name="$1"
    read -r -a lutgen_args <<< "$PREV_ARGS"

    local cache_dir="/tmp/lutgen_preview_cache"
    mkdir -p "$cache_dir"

    local stamp="${sample_img}#${current_palette}#${custom_colors}#${color_strength}#${palette_limit}#${sat}#${contrast}#${bright}#${PREV_ARGS}"
    local stamp_file="$cache_dir/stamp"
    local rendered_file="$cache_dir/rendered.txt"

    # If settings have not changed, output cached view immediately (no real-time recalculation)
    if [[ -f "$stamp_file" && -s "$rendered_file" && "$(< "$stamp_file")" == "$stamp" ]]; then
        cat "$rendered_file"
        return 0
    fi

    # Render fresh preview once
    {
        echo -e "\e[1;36m󰏘 Live Preview\e[0m"
        echo -e "  \e[1;35m Palette:\e[0m $current_palette"
        echo -e "  \e[1;32m🎨 Colors:\e[0m ${custom_colors:-Default (All)}"
        echo -e "  \e[1;34m⚡ Strength:\e[0m ${color_strength}%  |  \e[1;34m🎯 Limit:\e[0m $palette_limit"
        echo ""

        if [[ -n "$sample_img" && -f "$sample_img" ]]; then
            base_name=$(basename "$sample_img")
            thumb="$cache_dir/thumb_${base_name}.png"
            out="$cache_dir/processed_${base_name}.png"

            # Downscale for responsiveness
            if [[ ! -f "$thumb" || "$sample_img" -nt "$thumb" ]]; then
                "$im_cmd" "$sample_img" -resize 400x400\> "$thumb" 2>/dev/null || cp "$sample_img" "$thumb"
            fi

            get_preview_sorted_palette() {
                local pal="$1"
                local raw=""
                local file_cand=""
                [[ -f "$lutgen_dir/${pal}-dark" ]] && file_cand="$lutgen_dir/${pal}-dark"
                [[ -z "$file_cand" && -f "$lutgen_dir/$pal" ]] && file_cand="$lutgen_dir/$pal"
                [[ -z "$file_cand" && -f "$lutgen_dir/${pal}-light" ]] && file_cand="$lutgen_dir/${pal}-light"
                if [[ -n "$file_cand" ]]; then
                    for w in $(< "$file_cand"); do
                        w="${w//\"/}"; w="${w//,/}"; w="${w//#/}"
                        [[ ${#w} -eq 6 && "$w" =~ ^[0-9a-fA-F]{6}$ ]] && raw+="#${w,,} "
                    done
                elif lutgen palette "$pal" &>/dev/null; then
                    raw=$(lutgen palette "$pal" 2>/dev/null | grep -E "^#[0-9a-fA-F]{6}$")
                elif lutgen palette "${pal}-dark" &>/dev/null; then
                    raw=$(lutgen palette "${pal}-dark" 2>/dev/null | grep -E "^#[0-9a-fA-F]{6}$")
                fi

                [[ -z "$raw" ]] && return 1

                local -a sorted=($(for c in $raw; do
                    hex="${c//#/}"
                    r=$((16#${hex:0:2}))
                    g=$((16#${hex:2:2}))
                    b=$((16#${hex:4:2}))
                    lum=$(( (299 * r + 587 * g + 114 * b) / 1000 ))
                    echo "$lum $c"
                done | sort -n | awk '{print $2}'))
                echo "${sorted[@]}"
            }

            apply_lutgen() {
                local input="$1"
                local output="$2"
                local pal_name="$3"
                local custom_hex="$4"

                local -a p_opt=()
                local -a c_args=()

                if [[ -n "$custom_hex" ]]; then
                    read -r -a hex_list <<< "$custom_hex"
                    c_args=(-- "${hex_list[@]}")
                else
                    local -a sorted_pal=($(get_preview_sorted_palette "$pal_name"))
                    case "${palette_limit:-All}" in
                        2)
                            if [[ ${#sorted_pal[@]} -ge 2 ]]; then
                                c_args=(-- "${sorted_pal[0]}" "${sorted_pal[-1]}")
                            else
                                p_opt=(-p "${pal_name,,}")
                            fi
                            ;;
                        4)
                            if [[ ${#sorted_pal[@]} -ge 4 ]]; then
                                local n=${#sorted_pal[@]}
                                c_args=(-- "${sorted_pal[0]}" "${sorted_pal[$(( n / 3 ))]}" "${sorted_pal[$(( (2 * n) / 3 ))]}" "${sorted_pal[$(( n - 1 ))]}")
                            else
                                c_args=(-- "${sorted_pal[@]}")
                            fi
                            ;;
                        8)
                            if [[ ${#sorted_pal[@]} -ge 8 ]]; then
                                local n=${#sorted_pal[@]}
                                local -a subset=()
                                for ((k=0; k<8; k++)); do
                                    subset+=("${sorted_pal[$(( (k * (n - 1)) / 7 ))]}")
                                done
                                c_args=(-- "${subset[@]}")
                            else
                                c_args=(-- "${sorted_pal[@]}")
                            fi
                            ;;
                        *)
                            local cand="${pal_name,,}"
                            if lutgen palette "$cand" &>/dev/null; then
                                p_opt=(-p "$cand")
                            elif lutgen palette "${cand}-dark" &>/dev/null; then
                                p_opt=(-p "${cand}-dark")
                            else
                                if [[ ${#sorted_pal[@]} -gt 0 ]]; then
                                    c_args=(-- "${sorted_pal[@]}")
                                else
                                    p_opt=(-p "$cand")
                                fi
                            fi
                            ;;
                    esac
                fi

                lutgen apply "${lutgen_args[@]}" "${p_opt[@]}" "$input" -o "$output" "${c_args[@]}"
            }

            err_log="$cache_dir/err.log"
            success=false

            if apply_lutgen "$thumb" "$out" "$current_palette" "$custom_colors" &>"$err_log" && [[ -f "$out" ]]; then
                success=true
            fi

            if [[ "$success" == "true" ]]; then
                if [[ "$color_strength" -lt 100 ]]; then
                    "$im_cmd" "$thumb" "$out" -define compose:args="$color_strength" -compose blend -composite "$out" 2>/dev/null
                fi

                if [[ "$sat" != "100" || "$contrast" != "0" || "$bright" != "100" ]]; then
                    "$im_cmd" "$out" -modulate "${bright},${sat},100" -brightness-contrast "0x${contrast}" "$out" 2>/dev/null
                fi

                lines=${FZF_PREVIEW_LINES:-24}
                cols=${FZF_PREVIEW_COLUMNS:-50}
                chafa_lines=$(( lines > 8 ? lines - 6 : lines ))
                chafa -f sixel -s "${cols}x${chafa_lines}" "$out" 2>/dev/null || chafa -s "${cols}x${chafa_lines}" "$out"
                echo -e "\n  \e[2m[Sample: $base_name | Sat: ${sat}% | Cont: ${contrast} | Bri: ${bright}%]\e[0m"
            else
                chafa -f sixel -s "${FZF_PREVIEW_COLUMNS}x$((FZF_PREVIEW_LINES - 6))" "$thumb" 2>/dev/null || chafa "$thumb"
                echo -e "\n  \e[1;31m[Notice: Could not render processed preview]\e[0m"
                if [[ -f "$err_log" ]]; then
                    head -n 2 "$err_log" | sed 's/^/  /'
                fi
            fi
        else
            echo -e "  \e[1;33m[!] No sample image found for live preview.\e[0m\n"
        fi
    } > "$rendered_file"

    echo "$stamp" > "$stamp_file"
    cat "$rendered_file"
}

main_preview "$1"
EOF
chmod +x "$LIVE_PREVIEW_SCRIPT"


# /*
#  * CORE FUNCTIONS
#  */

# // Sanity check: prevent headaches by verifying dependencies upfront
check_deps() {
    for cmd in lutgen jq curl tar fzf chafa; do
        if ! command -v "$cmd" &> /dev/null; then
            echo -e "${C_RED}[ERROR] Missing dependency: '$cmd'.${C_RESET}"
            exit 1
        fi
    done
}

# // Sync Noctalia repo. Uses a cache flag to avoid spamming the GitHub API

sync_palettes() {
    local force_sync="$1"
    if [[ -f "$SYNC_MARKER" && "$force_sync" != "true" ]]; then
        return # // Already cached, exit early
    fi

    echo -e "${C_BLUE}[*] Syncing palettes from GitHub...${C_RESET}"
    local tmp_dir=$(mktemp -d)

    # // Download tarball and extract on-the-fly
    if curl -sL "${REPO_URL%/}/archive/refs/heads/main.tar.gz" | tar -xz -C "$tmp_dir" --strip=1 &> /dev/null; then
        find "$tmp_dir" -name "*.json" | while read -r file; do
            local base_name=$(basename "$(dirname "$file")")
            [[ "$base_name" == *"$tmp_dir"* ]] && base_name="${file%.json}"

            # // Parse JSON with jq and extract only the required hex values
            for variant in dark light; do
                local colors=$(jq -r ".[ \"$variant\" ] | [.mSurface, .mOnSurface, .mPrimary, .mSecondary, .mTertiary] | map(strings | sub(\"^#\"; \"\") | ascii_downcase) | unique | join(\" \")" "$file" 2>/dev/null)
                if [[ -n "$colors" ]]; then
                    echo "$colors" > "$LUTGEN_DIR/${base_name,,}-${variant}"
                fi
            done
        done
        touch "$SYNC_MARKER"
        echo -e "${C_GREEN}[OK] Palettes synchronized.${C_RESET}"
        sleep 1
    else
        echo -e "${C_RED}[ERROR] Download failed.${C_RESET}"
        sleep 2
    fi
    rm -rf "$tmp_dir"
}

# // Regenerate lutgen config file based on our local text files

generate_toml() {
    local toml_file="$LUTGEN_DIR/palettes.toml"
    > "$toml_file" # // Truncate file

    for file in "$LUTGEN_DIR/"*; do
        if [ -f "$file" ] && [[ "$file" != *.toml ]] && [[ "$file" != *.synced ]] && [[ "$file" != "$CONFIG_FILE" ]]; then
            local name=$(basename "$file")
            local colors_toml=$(awk '{ for(i=1;i<=NF;i++) printf "\"%s\"%s", ($i ~ /^#/ ? $i : "#"$i), (i==NF ? "" : ", ") }' "$file")
            echo "[\"${name,,}\"]" >> "$toml_file"
            echo "colors = [$colors_toml]" >> "$toml_file"
            echo "" >> "$toml_file"
        fi
    done
}

# /*
#  * PROCESSING SETTINGS (ricer.conf)
#  * Persisted lutgen apply parameters, loaded on startup.
#  */

# // Load settings from ricer.conf, falling back to defaults for missing/invalid keys
load_config() {
    # // First run: materialize the defaults so the file is editable by hand
    if [[ ! -f "$CONFIG_FILE" ]]; then
        save_config
        return
    fi

    local key val
    while IFS='=' read -r key val; do
        key="${key// /}"
        [[ -z "$key" || "$key" == \#* ]] && continue
        val="${val%$'\r'}" # // Strip CR from CRLF files

        case "$key" in
            ALGORITHM)  [[ "$val" =~ ^(gaussian-blur|gaussian-rbf|gaussian-sampling|shepards|nearest-neighbor)$ ]] && ALGORITHM="$val" ;;
            PRESERVE)   [[ "$val" =~ ^(true|false)$ ]] && PRESERVE="$val" ;;
            LUM)        [[ "$val" =~ ^[0-9]+([.][0-9]+)?$ ]] && LUM="$val" ;;
            SHAPE)      [[ "$val" =~ ^[0-9]+([.][0-9]+)?$ ]] && SHAPE="$val" ;;
            NEAREST)    [[ "$val" =~ ^[0-9]+$ ]] && NEAREST="$val" ;;
            LEVEL)      [[ "$val" =~ ^([2-9]|1[0-6])$ ]] && LEVEL="$val" ;;
            RADIUS)     [[ "$val" =~ ^[0-9]+([.][0-9]+)?$ ]] && RADIUS="$val" ;;
            SATURATION)     [[ "$val" =~ ^[0-9]+$ ]] && SATURATION="$val" ;;
            CONTRAST)       [[ "$val" =~ ^-?[0-9]+$ ]] && CONTRAST="$val" ;;
            BRIGHTNESS)     [[ "$val" =~ ^[0-9]+$ ]] && BRIGHTNESS="$val" ;;
            COLOR_STRENGTH) [[ "$val" =~ ^[0-9]+$ ]] && COLOR_STRENGTH="$val" ;;
            PALETTE_LIMIT)  [[ "$val" =~ ^(All|8|4|2)$ ]] && PALETTE_LIMIT="$val" ;;
        esac
    done < "$CONFIG_FILE"
    return 0
}

# // Persist current settings to ricer.conf
save_config() {
    cat > "$CONFIG_FILE" << EOF
# // LUTGEN RICER -- processing settings
# // ALGORITHM: gaussian-blur | gaussian-rbf | gaussian-sampling | shepards | nearest-neighbor
ALGORITHM=$ALGORITHM
PRESERVE=$PRESERVE
LUM=$LUM
SHAPE=$SHAPE
NEAREST=$NEAREST
LEVEL=$LEVEL
RADIUS=$RADIUS
SATURATION=$SATURATION
CONTRAST=$CONTRAST
BRIGHTNESS=$BRIGHTNESS
COLOR_STRENGTH=$COLOR_STRENGTH
PALETTE_LIMIT=$PALETTE_LIMIT
EOF
}

# // Build the algorithm-specific lutgen apply arguments into LUTGEN_ARGS
build_lutgen_args() {
    LUTGEN_ARGS=()

    # // Interpolation algorithm (default gaussian-blur needs no flag)
    case "$ALGORITHM" in
        gaussian-rbf)      LUTGEN_ARGS+=(-R) ;;
        gaussian-sampling) LUTGEN_ARGS+=(-G) ;;
        shepards)          LUTGEN_ARGS+=(-S) ;;
        nearest-neighbor)  LUTGEN_ARGS+=(-N) ;;
    esac

    # // Parameters only meaningful per-algorithm
    case "$ALGORITHM" in
        gaussian-rbf)
            LUTGEN_ARGS+=(--shape "$SHAPE" --nearest "$NEAREST")
            ;;
        shepards)
            LUTGEN_ARGS+=(--nearest "$NEAREST")
            ;;
        gaussian-blur)
            LUTGEN_ARGS+=(--radius "$RADIUS")
            ;;
    esac

    LUTGEN_ARGS+=(--level "$LEVEL")
    [[ "$PRESERVE" == "true" ]] && LUTGEN_ARGS+=(--preserve)
    LUTGEN_ARGS+=(--lum "$LUM")
}

# // Reset processing settings to their defaults
reset_settings() {
    ALGORITHM="gaussian-blur"; PRESERVE="false"; LUM="1.0"; SHAPE="128.0"; NEAREST="16"; LEVEL="10"; RADIUS="8.0"
    SATURATION="100"; CONTRAST="0"; BRIGHTNESS="100"; COLOR_STRENGTH="100"; PALETTE_LIMIT="All"
    save_config
}

# // Read a validated value from the terminal. Returns 1 on empty/invalid input.
prompt_value() {
    local label="$1" current="$2" regex="$3"
    local value

    printf "%s [%s]: " "$label" "$current" >&2
    read -r value </dev/tty

    [[ -z "$value" ]] && return 1
    if [[ ! "$value" =~ $regex ]]; then
        echo -e "${C_RED}[!] Invalid value: '$value'.${C_RESET}" >&2
        sleep 1
        return 1
    fi
    echo "$value"
}

# // Helper to locate or pick an image for live preview
get_sample_image() {
    if [[ -n "$SAMPLE_IMAGE" && -f "$SAMPLE_IMAGE" ]]; then
        echo "$SAMPLE_IMAGE"
        return 0
    fi
    if [[ ${#SELECTED_FILES[@]} -gt 0 && -f "${SELECTED_FILES[0]}" ]]; then
        echo "${SELECTED_FILES[0]}"
        return 0
    fi
    local found
    found=$(find . -maxdepth 2 -type f \( "${IMG_PATTERN[@]}" \) 2>/dev/null | head -n 1)
    if [[ -n "$found" && -f "$found" ]]; then
        echo "$found"
        return 0
    fi
    echo ""
}

# // Retrieve raw hex colors from a palette name (returns at most 4 main colors)
# // Prioritizes Noctalia custom palettes from LUTGEN_DIR
get_palette_hex_colors() {
    local palette="$1"
    local cand="${palette,,}"

    # 1. Read from LUTGEN_DIR files FIRST (Noctalia custom palettes)
    local file_cand=""
    if [[ -f "$LUTGEN_DIR/${cand}-dark" ]]; then
        file_cand="$LUTGEN_DIR/${cand}-dark"
    elif [[ -f "$LUTGEN_DIR/$cand" ]]; then
        file_cand="$LUTGEN_DIR/$cand"
    elif [[ -f "$LUTGEN_DIR/${cand}-light" ]]; then
        file_cand="$LUTGEN_DIR/${cand}-light"
    elif [[ -f "$LUTGEN_DIR/${cand// /-}-dark" ]]; then
        file_cand="$LUTGEN_DIR/${cand// /-}-dark"
    elif [[ -f "$LUTGEN_DIR/${cand%-dark}-dark" ]]; then
        file_cand="$LUTGEN_DIR/${cand%-dark}-dark"
    fi

    if [[ -n "$file_cand" ]]; then
        local raw
        raw=$(< "$file_cand")
        local count=0
        for word in $raw; do
            word="${word//\"/}"
            word="${word//,/}"
            word="${word//#/}"
            if [[ ${#word} -eq 6 && "$word" =~ ^[0-9a-fA-F]{6}$ ]]; then
                echo "#${word,,}"
                ((count++))
                [[ $count -ge 4 ]] && return 0
            fi
        done
        [[ $count -gt 0 ]] && return 0
    fi

    # 2. Try lutgen palette built-in (sample the 4 main representative colors)
    local raw_builtin=""
    if lutgen palette "$cand" &>/dev/null; then
        raw_builtin=$(lutgen palette "$cand" 2>/dev/null | grep -E '^#[0-9a-fA-F]{6}$')
    elif lutgen palette "${cand}-dark" &>/dev/null; then
        raw_builtin=$(lutgen palette "${cand}-dark" 2>/dev/null | grep -E '^#[0-9a-fA-F]{6}$')
    fi

    if [[ -n "$raw_builtin" ]]; then
        local -a b_colors=($raw_builtin)
        local n=${#b_colors[@]}
        if [[ $n -le 4 ]]; then
            printf "%s\n" "${b_colors[@]}"
        else
            echo "${b_colors[0]}"
            echo "${b_colors[$(( n / 3 ))]}"
            echo "${b_colors[$(( (2 * n) / 3 ))]}"
            echo "${b_colors[$(( n - 1 ))]}"
        fi
        return 0
    fi

    return 1
}

# // Return all colors of a palette sorted by perceived luminance (darkest to brightest)
get_palette_colors_sorted() {
    local pal="$1"
    local raw
    raw=$(get_palette_hex_colors "$pal")
    [[ -z "$raw" ]] && return 1

    local -a sorted=($(for c in $raw; do
        hex="${c//#/}"
        r=$((16#${hex:0:2}))
        g=$((16#${hex:2:2}))
        b=$((16#${hex:4:2}))
        lum=$(( (299 * r + 587 * g + 114 * b) / 1000 ))
        echo "$lum $c"
    done | sort -n | awk '{print $2}'))
    echo "${sorted[@]}"
}

# // Interactively choose specific colors from the current palette
# // Shows a list of palette colors with ANSI previews where Enter or Space toggles selection
pick_palette_colors() {
    local pal_to_query="$CURRENT_PALETTE"

    local raw_colors
    raw_colors=$(get_palette_hex_colors "$pal_to_query")
    if [[ -z "$raw_colors" ]]; then
        echo -e "${C_YELLOW}[!] Could not retrieve colors for '$pal_to_query'.${C_RESET}"
        sleep 1
        return 0
    fi

    local -a pal_colors=()
    declare -A seen=()
    while read -r line; do
        if [[ -n "$line" && -z "${seen["$line"]}" ]]; then
            seen["$line"]=1
            pal_colors+=("$line")
        fi
    done <<< "$raw_colors"

    if [[ ${#pal_colors[@]} -eq 0 ]]; then
        echo -e "${C_YELLOW}[!] No colors found in '$pal_to_query'.${C_RESET}"
        sleep 1
        return 0
    fi

    # Maintain selected state in an associative array
    declare -A is_selected=()
    if [[ ${#SELECTED_COLORS[@]} -gt 0 ]]; then
        for c in "${SELECTED_COLORS[@]}"; do
            is_selected["$c"]=1
        done
    else
        # Default: all colors selected
        for c in "${pal_colors[@]}"; do
            is_selected["$c"]=1
        done
    fi

    local cursor_pos=4  # Start on the first color (after Confirm, Select All, Deselect All)

    while true; do
        local count_sel=0
        for c in "${pal_colors[@]}"; do
            [[ -n "${is_selected["$c"]}" ]] && ((count_sel++))
        done

        local menu_lines=()
        menu_lines+=("✔ [ Confirm selection ($count_sel/${#pal_colors[@]} selected) ]")
        menu_lines+=("● [ Select all colors ]")
        menu_lines+=("○ [ Deselect all colors ]")

        for hex in "${pal_colors[@]}"; do
            local mark=" "
            [[ -n "${is_selected["$hex"]}" ]] && mark="●"

            local r=$((16#${hex:1:2}))
            local g=$((16#${hex:3:2}))
            local b=$((16#${hex:5:2}))

            local line_str
            line_str=$(printf "  [%s]  \e[48;2;%d;%d;%dm        \e[0m  %s" "$mark" "$r" "$g" "$b" "$hex")
            menu_lines+=("$line_str")
        done

        local out
        out=$(printf '%s\n' "${menu_lines[@]}" | fzf --ansi \
            --prompt="🎨 Colors [${pal_to_query}] ❯ " \
            --header="[ENTER / SPACE]: Toggle color  |  [CTRL-A]: All  |  [CTRL-D]: None  |  [ESC]: Back" \
            --expect=space,ctrl-a,ctrl-d,ctrl-r,tab \
            --bind="start:pos($cursor_pos)")

        local ret=$?
        [[ $ret -ne 0 && -z "$out" ]] && return 0

        local key item
        key=$(head -n 1 <<< "$out")
        item=$(tail -n +2 <<< "$out")
        [[ -z "$item" ]] && item="$key"

        [[ -z "$item" ]] && return 0

        # Track cursor line
        local chosen_idx=1
        for i in "${!menu_lines[@]}"; do
            local clean_menu
            clean_menu=$(sed 's/\x1b\[[0-9;]*m//g' <<< "${menu_lines[$i]}")
            local clean_item
            clean_item=$(sed 's/\x1b\[[0-9;]*m//g' <<< "$item")
            if [[ "$clean_menu" == "$clean_item" ]]; then
                chosen_idx=$((i + 1))
                break
            fi
        done
        cursor_pos=$chosen_idx

        # Handle shortcuts
        if [[ "$key" == "ctrl-a" ]]; then
            for c in "${pal_colors[@]}"; do is_selected["$c"]=1; done
            continue
        elif [[ "$key" == "ctrl-d" ]]; then
            for c in "${pal_colors[@]}"; do unset "is_selected[$c]"; done
            continue
        elif [[ "$key" == "ctrl-r" ]]; then
            for c in "${pal_colors[@]}"; do is_selected["$c"]=1; done
            continue
        fi

        case "$item" in
            *"✔"*)
                SELECTED_COLORS=()
                if [[ $count_sel -eq 0 || $count_sel -eq ${#pal_colors[@]} ]]; then
                    SELECTED_COLORS=()
                    echo -e "${C_CYAN}[i] Using all palette colors.${C_RESET}"
                else
                    for c in "${pal_colors[@]}"; do
                        [[ -n "${is_selected["$c"]}" ]] && SELECTED_COLORS+=("$c")
                    done
                    echo -e "${C_GREEN}[OK] Set to ${#SELECTED_COLORS[@]} selected colors.${C_RESET}"
                fi
                sleep 0.5
                return 0
                ;;
            *"● [ Select all"*)
                for c in "${pal_colors[@]}"; do is_selected["$c"]=1; done
                ;;
            *"○ [ Deselect all"*)
                for c in "${pal_colors[@]}"; do unset "is_selected[$c]"; done
                ;;
            *)
                local hex_code
                hex_code=$(echo "$item" | grep -oE '#[0-9a-fA-F]{6}')
                if [[ -n "$hex_code" ]]; then
                    if [[ -n "${is_selected["$hex_code"]}" ]]; then
                        unset "is_selected[$hex_code]"
                    else
                        is_selected["$hex_code"]=1
                    fi
                fi
                if [[ "$key" == "tab" ]]; then
                    cursor_pos=$((chosen_idx < ${#menu_lines[@]} ? chosen_idx + 1 : chosen_idx))
                fi
                ;;
        esac
    done
}

# // Select a new palette interactively, separating Local/GitHub from Built-in
pick_palette_interactive() {
    local current_val="$CURRENT_PALETTE"

    local source_type
    source_type=$(printf "1. Custom (Local Repository)\n2. Built-in (Lutgen Native)" | \
        fzf --prompt="  Palette Source ❯ " --header="[ESC]: Keep '$current_val'")
    [[ -z "$source_type" ]] && return 0

    local chosen=""
    if [[ "$source_type" == 1* ]]; then
        mapfile -t schemes < <(find "$LUTGEN_DIR" -maxdepth 1 -type f ! -name "*.toml" ! -name ".synced" ! -name "$CONFIG_NAME" -exec basename {} \; 2>/dev/null | sed -E 's/-(dark|light)$//' | sort -u)
        chosen=$(printf "%s\n" "${schemes[@]}" | fzf \
            --prompt="  Select Custom Palette ❯ " \
            --header="[ESC]: Cancel" \
            --preview "'$PREVIEW_SCRIPT' '$LUTGEN_DIR' {}" \
            --preview-window=right:50%:border-left)
        generate_toml
    else
        mapfile -t lutgen_schemes < <(lutgen palette names 2>/dev/null | sort)
        chosen=$(printf "%s\n" "${lutgen_schemes[@]}" | fzf \
            --prompt="󰏘  Select Built-in Palette ❯ " \
            --header="[ESC]: Cancel" \
            --preview "'$LUTGEN_PREVIEW_SCRIPT' {}" \
            --preview-window=right:50%:border-left)
    fi

    if [[ -n "$chosen" ]]; then
        CURRENT_PALETTE="$chosen"
        SELECTED_COLORS=()
        echo -e "${C_GREEN}[OK] Palette set to $CURRENT_PALETTE.${C_RESET}"
        sleep 0.5
    fi
}

# // Read or pick a setting value using fzf with presets + custom input
prompt_setting_value() {
    local label="$1" current="$2" presets="$3" regex="$4"
    local out query selected choice

    out=$(printf "%s\n" $presets | fzf --prompt="$label ❯ " \
        --header="Current: $current | Select or type new value, then [ENTER] | [ESC]: Cancel" \
        --print-query)
    [[ -z "$out" ]] && return 1

    query=$(head -n 1 <<< "$out")
    selected=$(tail -n 1 <<< "$out")

    choice="$selected"
    if [[ -n "$query" && "$query" != "$selected" ]]; then
        choice="$query"
    fi

    if [[ -n "$regex" && ! "$choice" =~ $regex ]]; then
        echo -e "${C_RED}[!] Invalid value: '$choice'.${C_RESET}"
        sleep 1
        return 1
    fi

    echo "$choice"
}

# // Resolve dark and light theme variants and destination base folder for CURRENT_PALETTE
resolve_theme_variants() {
    local pal="$CURRENT_PALETTE"
    local base="${pal%-dark}"
    base="${base%-light}"

    DEST_BASE="$base"

    # 1. Custom palette files in LUTGEN_DIR
    if [[ -f "$LUTGEN_DIR/${base}-dark" && -f "$LUTGEN_DIR/${base}-light" ]]; then
        THEME_DARK="${base}-dark"
        THEME_LIGHT="${base}-light"
        return
    fi

    # 2. Built-in palettes in lutgen
    if lutgen palette "${base}-dark" &>/dev/null && lutgen palette "${base}-light" &>/dev/null; then
        THEME_DARK="${base}-dark"
        THEME_LIGHT="${base}-light"
        return
    fi

    # 3. Explicit -dark palette name
    if [[ "$pal" == *"-dark" ]]; then
        THEME_DARK="$pal"
        local light_cand="${pal%-dark}-light"
        if [[ -f "$LUTGEN_DIR/$light_cand" ]] || lutgen palette "$light_cand" &>/dev/null; then
            THEME_LIGHT="$light_cand"
        else
            THEME_LIGHT="$pal"
        fi
        return
    fi

    # 4. Explicit -light palette name
    if [[ "$pal" == *"-light" ]]; then
        THEME_LIGHT="$pal"
        local dark_cand="${pal%-light}-dark"
        if [[ -f "$LUTGEN_DIR/$dark_cand" ]] || lutgen palette "$dark_cand" &>/dev/null; then
            THEME_DARK="$dark_cand"
        else
            THEME_DARK="$pal"
        fi
        return
    fi

    # 5. Fallback for single palette
    THEME_DARK="$pal"
    THEME_LIGHT="$pal"
}

